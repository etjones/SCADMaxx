{
  "schema": 1,
  "description": "Portable integration regression corpus; fixtures authored for SCADMaxx, no external SCAD libraries.",
  "policy": {
    "repetitions": 5,
    "warmups": 1,
    "timeout_seconds": 90,
    "relative_limit": 0.15,
    "absolute_limit_seconds": 0.1,
    "max_relative_mad": 0.15,
    "calibration": "Initial conservative limits; require review after the first baseline series. Never auto-promote a baseline."
  },
