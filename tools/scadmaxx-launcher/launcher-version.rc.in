#include <windows.h>
VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "SCADMaxx\0"
   VALUE "FileDescription", "SCADMaxx Launcher\0"
   VALUE "FileVersion", "@LAUNCHER_VERSION@\0"
   VALUE "InternalName", "scadmaxx-launcher\0"
   VALUE "OriginalFilename", "scadmaxx-launcher.exe\0"
   VALUE "ProductName", "SCADMaxx Launcher\0"
   VALUE "ProductVersion", "@LAUNCHER_VERSION@\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
